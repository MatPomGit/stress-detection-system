{
  "name": "stress-detection-system",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time stress detection system for IT & remote workers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "cd packages/backend && poetry run python src/main.py",
    "dev:frontend": "cd packages/frontend && pnpm dev",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build:backend": "cd packages/backend && poetry build",
    "build:frontend": "cd packages/frontend && pnpm build",
    "build": "pnpm build:backend && pnpm build:frontend",
    "test:backend": "cd packages/backend && poetry run pytest",
    "test:frontend": "cd packages/frontend && pnpm test",
    "test": "pnpm test:backend && pnpm test:frontend",
    "benchmark": "cd packages/backend && poetry run pytest tests/benchmarks/ -v --benchmark-only"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhuvii-nuvai/stress-detection-system.git"
  },
  "author": "Nuvai Team",
  "license": "MIT"
}
